# This root file documents shared names only. Keep actual values in each app's local env file.
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

# Public client credentials. The anon key is safe to expose only with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-eas-project-id
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server-only secrets belong in the deployment secret manager, never EXPO_PUBLIC/NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=replace-only-in-server-environment
