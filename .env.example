# This root file documents shared names only. Keep actual values in each app's local env file.
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Admin environment inventory and staging free-tier guardrails. These values
# are server-side configuration; provider usage must be supplied by a trusted
# usage source before launch. The defaults keep staging on the free plan.
SDS_STAGING_SITE_URL=
SDS_STAGING_SUPABASE_PROJECT_REF=
SDS_PRODUCTION_SITE_URL=
SDS_PRODUCTION_SUPABASE_PROJECT_REF=
SDS_STAGING_BILLING_LOCK=true
SDS_STAGING_WARN_PERCENT=80
SDS_STAGING_HOLD_PERCENT=95
SDS_STAGING_DATABASE_QUOTA_MB=500
SDS_STAGING_STORAGE_QUOTA_GB=1
SDS_STAGING_EGRESS_QUOTA_GB=5
SDS_STAGING_MAU_QUOTA=50000
EXPO_PUBLIC_APP_ENV=development

# Public client credentials. The anon key is safe to expose only with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_SITE_URL=http://localhost:3000
# Set this to a reachable LAN/public URL when sharing links with another device.
NEXT_PUBLIC_SHARE_BASE_URL=
EXPO_PUBLIC_SHARE_BASE_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-eas-project-id
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Native Google Sign-In credentials for the sds-local-508919 project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-with-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace-with-google-ios-client-id
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=replace-with-reversed-ios-client-id
# Stripe's publishable key is safe for the client, but leave blank until the
# server-side PaymentIntent flow is implemented. Never expose a secret key.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=
EXPO_PUBLIC_STRIPE_ENABLE_GOOGLE_PAY=false
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=business_listing
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Server-only secrets belong in the deployment secret manager, never EXPO_PUBLIC/NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=replace-only-in-server-environment
# Server-only RevenueCat webhook configuration. Use a different high-entropy
# secret for staging and production. Never expose either value to the app.
REVENUECAT_WEBHOOK_SECRET=replace-only-in-server-environment
BILLING_ENVIRONMENT=sandbox

# Local Supabase Google OAuth (keep real values in the ignored root .env file).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-web-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-with-google-web-client-secret

# Square pickup commerce: SERVER ONLY. Leave credentials empty in examples.
# See docs/square-commerce.md. No Square secrets belong in an app .env file.
# Uses the explicit APP_ENV above (development locally, staging on staging).
SQUARE_ENVIRONMENT=
SQUARE_COMMERCE_ENABLED=false
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_OAUTH_REDIRECT_URL=
SQUARE_WEBHOOK_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_TOKEN_ENCRYPTION_KEY=
SQUARE_TOKEN_KEY_VERSION=
# Optional JSON object mapping previous key-version labels to base64 AES keys.
SQUARE_TOKEN_PREVIOUS_KEYS=
SQUARE_API_VERSION=
SQUARE_MAINTENANCE_SECRET=
SQUARE_ALLOWED_ORIGIN=
# Stripe Connect pickup commerce: SERVER ONLY, test mode in development/staging.
# Connect accounts receive payment directly; SDS application fees are fixed at $0 in code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_RETURN_URL=
STRIPE_CONNECT_CALLBACK_URL=
STRIPE_APP_RETURN_URL=sdslocal://business
STRIPE_CONNECT_APP_RETURN_URL=sdslocal://business
STRIPE_COMMERCE_ENABLED=false
STRIPE_ALLOWED_ORIGIN=
