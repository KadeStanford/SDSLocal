NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side admin console environment inventory. Leave staging and
# production blank until their projects and HTTPS deployments exist.
SDS_STAGING_SITE_URL=
SDS_STAGING_SUPABASE_PROJECT_REF=
SDS_PRODUCTION_SITE_URL=
SDS_PRODUCTION_SUPABASE_PROJECT_REF=
SDS_STAGING_BILLING_LOCK=true
SDS_STAGING_WARN_PERCENT=80
SDS_STAGING_HOLD_PERCENT=95
SDS_STAGING_DATABASE_QUOTA_MB=500
SDS_STAGING_STORAGE_QUOTA_GB=1
SDS_STAGING_EGRESS_QUOTA_GB=5
SDS_STAGING_MAU_QUOTA=50000
# Staging sharing requires the real public HTTPS web origin. Never use a LAN,
# loopback, or .local address here for a hosted deployment.
NEXT_PUBLIC_SHARE_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Set NEXT_PUBLIC_APP_ENV=staging to use the hosted staging project.
NEXT_PUBLIC_STAGING_SUPABASE_URL=
NEXT_PUBLIC_STAGING_SUPABASE_PUBLISHABLE_KEY=
