EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SITE_URL=http://localhost:3000
# Preview sharing requires the real public HTTPS web origin. Never use a LAN,
# loopback, or .local address in the EAS preview environment.
EXPO_PUBLIC_SHARE_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Set EXPO_PUBLIC_APP_ENV=staging to use the hosted staging project.
EXPO_PUBLIC_STAGING_SUPABASE_URL=
EXPO_PUBLIC_STAGING_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Native Google Sign-In credentials from the sds-local-508919 project.
# The Web client ID is used to exchange the native ID token with Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID and its reversed URL scheme are required for iOS builds.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
# Stripe's native Connect onboarding and future PaymentSheet need this public
# key. Keep Stripe secret and webhook keys in Supabase Function secrets only.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Required only when enabling Apple Pay for Stripe.
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=
EXPO_PUBLIC_STRIPE_ENABLE_GOOGLE_PAY=false

# Store-compliant business listing subscriptions. These are public SDK keys,
# not RevenueCat secret keys. Adding the SDK requires a new native build; OTA
# can update the paywall only after that build is installed.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=business_listing
# Store-review legal links must be public HTTPS pages.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_PRIVACY_URL=

